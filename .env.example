# FindBack AI Production Environment Variables Template

# ==================================================
# BACKEND ENVIRONMENT VARIABLES (Set on Render)
# ==================================================

# JWT Secret Key (Generate a random 64-character string: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate-a-random-64-char-production-secret-key

# Database Connection URL (SQLite default for local dev, PostgreSQL for Render)
# Local SQLite: sqlite:///lost_and_found.db
# Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/findback_db

# Allowed CORS Origins (Comma-separated origins for production frontend)
CORS_ORIGINS=https://findback-ai.vercel.app,http://localhost:5173

# Web Server Port (Render sets $PORT automatically, defaults to 8000 locally)
PORT=8000

# Google OAuth Credentials (Optional - if re-enabling Google login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==================================================
# FRONTEND ENVIRONMENT VARIABLES (Set on Vercel)
# ==================================================

# Backend Production API Base URL (Render URL)
VITE_API_URL=https://findback-ai.onrender.com
